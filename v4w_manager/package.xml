<?xml version="1.0"?>
<package format="2">
  <name>v4w_manager</name>
  <version>0.1.0</version>
  <description>Starts and stops a robot's modules (control, camera, mapping, MPPI) on request; used by the Fleet panel in RViz.</description>
  <maintainer email="fracance@gmail.com">fracance</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>message_generation</build_depend>
  <depend>std_msgs</depend>
  <exec_depend>message_runtime</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>rosgraph</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
</package>
